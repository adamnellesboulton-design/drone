{
  "name": "NES Drone",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "NES Drone",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    }
  },
  "postAttachCommand": "npx --yes serve -l 8080 ."
}
