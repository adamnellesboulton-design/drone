{
  "name": "NES Drone",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "NES Drone",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    }
  },
  "postAttachCommand": "python3 -m http.server 8080 --bind 0.0.0.0"
}
